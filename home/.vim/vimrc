" ~/.vimrc
"
" @author Augusto Pascutti

" Plugins {{{
" https://github.com/junegunn/vim-plug

if empty(glob('~/.vim/autoload/plug.vim'))
  silent !curl -fLo ~/.vim/autoload/plug.vim --create-dirs
    \ https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
  autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

let g:plug_url_format = 'git@github.com:%s.git'

if (has("nvim"))
  call plug#begin('~/.vim/bundle_nvim')
else
  call plug#begin('~/.vim/bundle')
endif

" Essentials
Plug 'vim-syntastic/syntastic'
Plug 'tpope/vim-sensible'
Plug 'tpope/vim-fugitive'
Plug 'tpope/vim-sleuth'
Plug 'jistr/vim-nerdtree-tabs'
Plug 'editorconfig/editorconfig-vim'

" Project drawer (Fern)
Plug 'lambdalisue/fern.vim'
Plug 'lambdalisue/nerdfont.vim'
Plug 'lambdalisue/vim-fern-renderer-nerdfont'
Plug 'lambdalisue/vim-glyph-palette'
Plug 'lambdalisue/vim-fern-git-status'
map <C-n> :Fern . -reveal=% -drawer -toggle -width=35<CR>
let g:fern#renderer = "nerdfont"

augroup fern-warwick
  autocmd! *
  " Icons on file explorer
  autocmd FileType fern call glyph_palette#apply()
  autocmd FileType fall-list call glyph_palette#apply()
  autocmd FileType nerdtree,startify call glyph_palette#apply()
augroup END
set hidden

" Syntax or ecosystem plugins (loaded on demand)
Plug 'fatih/vim-go', { 'for': 'go', 'do': ':GoUpdateBinaries' }
Plug 'plasticboy/vim-markdown', { 'for': 'markdown' }
Plug 'pearofducks/ansible-vim', { 'for': 'yaml' }
Plug 'itspriddle/vim-shellcheck', { 'for': 'sh' }
Plug 'github/copilot.vim'

" Vanity
Plug 'vim-airline/vim-airline'
Plug 'ryanoasis/vim-devicons'

" nvim/vim exclusive plugins
if has("nvim")
    " UX
    Plug 'nvim-lua/plenary.nvim'
    Plug 'nvim-telescope/telescope.nvim', { 'tag': '0.1.6' }
    " Language Server Protocol
    Plug 'neovim/nvim-lspconfig'
    Plug 'hrsh7th/nvim-cmp'
    Plug 'hrsh7th/cmp-nvim-lsp'
    Plug 'hrsh7th/cmp-vsnip'
    Plug 'hrsh7th/vim-vsnip'
    Plug 'hrsh7th/cmp-nvim-lsp-signature-help'
    Plug 'folke/trouble.nvim'
    Plug 'onsails/lspkind.nvim'
    Plug 'williamboman/mason.nvim'
    Plug 'williamboman/mason-lspconfig.nvim'
    " Better syntax highlight
    Plug 'nvim-treesitter/nvim-treesitter', {'do': ':TSUpdate'}
    " Vanity
    Plug 'catppuccin/nvim', { 'as': 'catppuccin' }
    let g:airline_theme = 'catppuccin'
else " Only for VIM
  " Fuzzy finder (VIM Only so it doesn't conflict with Telescope
  Plug 'ctrlpvim/ctrlp.vim'
  let g:ctrlp_show_hidden=1
  let g:ctrlp_custom_ignore='\v[\/]\.(git|hg|svn)$'
  set guioptions=aAce
  " Vanity
  Plug 'catppuccin/vim', { 'as': 'catppuccin' }
  Plug 'vim-airline/vim-airline-themes'
  
  let g:airline_theme="catppuccin_mocha"
endif

call plug#end()
"}}}

if !has("nvim")
  colorscheme catppuccin_mocha
endif

" Visual Configuration {{{
set termguicolors
set background=dark
set t_Co=256
set encoding=UTF-8
"}}}

" Global Maps {{{
" -----------------------------------------------------------------------------

" vimgrep word under cursor
nnoremap <leader>s :grep! "<C-R><C-W>"<CR>:copen<CR>

" .vimrc reload
nnoremap <leader>vr :source $MYVIMRC<CR>
" .vimrc edit
nnoremap <leader>ve :tabedit $MYVIMRC<CR>
" }}}

" My Preferences {{{
set autoindent
set nowrap
set foldmethod=marker
set foldlevel=99    " fold level when opening a file
set incsearch
set hlsearch
set exrc
set sm              " show matching brackets
set ts=4            " tab stop
set et              " expand tabs
retab               " converts existing tabs
set ruler           " shows ruler
set laststatus=2   " lines of status
set nosmartindent   "
set novisualbell      " visual bell
set sw=4            " shift width (>)
set wildmode=longest,list:full
set cursorline      " highlugh current line
set number          " show line numbers (gutter-like)
set backspace=indent,eol,start
set tags=./.ctags,./tags,tags,~/.common_ctags
" }}}

" The silver searcher
if executable('ag')
    set grepprg=ag\ --nogroup\ --nocolor\ --column
    set grepformat=%f:%l:%c%m
    let g:ctrlp_user_command = 'ag %s -l --nocolor -g ""'
    let g:ctrlp_use_caching = 0
endif
